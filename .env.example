# Public site URL used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# GA4 web-stream measurement ID. Empty disables analytics; rebuild after changing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional public company details. Leave empty to hide them on the site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# Contact form delivery via SMTP (server-only).
# Port 465 normally uses SMTP_SECURE=true; port 587 normally uses false.
# When a required value is missing, the form reports that delivery is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Inbox(es) that receive enquiries, comma-separated.
CONTACT_TO_EMAIL=
# Sender verified by your SMTP provider, e.g. "IKASLE Website <web@yourdomain.com>".
# Leave empty to use SMTP_USER.
CONTACT_FROM_EMAIL=

# Optional chatbot. Without all three AI values, the widget honestly runs in limited local-assistance mode.
CHATBOT_ENABLED=true
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=

# Careers portal (/careers, application form, /admin/careers dashboard).
# Supabase project (Project Settings → API Keys). Applications are stored in Supabase tables and documents in
# the private "career-documents" Storage bucket. Run supabase/migrations/20261120000000_careers_portal.sql once
# in the Supabase SQL Editor first. Without these, the form says applications aren't available.
# The secret key is server-only: never prefix it with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Password for the admin dashboard at /admin/login.
CAREERS_ADMIN_PASSWORD=
# Random secret (32+ characters) that signs admin sessions, e.g. generate with: openssl rand -base64 48
CAREERS_SESSION_SECRET=
# Optional: inbox(es) for new-application emails, comma-separated. Defaults to CONTACT_TO_EMAIL.
CAREERS_TO_EMAIL=

# Public site URL used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional public company details. Leave empty to hide them on the site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# Contact form delivery (server-only). Uses the Resend HTTP API (https://resend.com).
# When any of these are missing, the form reports that delivery is not configured
# instead of pretending the message was sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "IKASLE Website <web@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Optional chatbot. Without all three AI values, the widget honestly runs in limited local-assistance mode.
CHATBOT_ENABLED=true
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
